{
  "OgnLaser": {
    "version": 1,
    "categories": "optics",
    "description": ["Optical laser node"],
    "language": "python",
    "inputs": {
      "wavelength": {
        "type": "float",
        "description": "Wavelength of the laser"
      },
      "position": {
        "type": "float[3]",
        "description": "Position in world coordinates"
      }
    },
    "outputs": {
      "out": {
        "type": "token",
        "description": "Output token or data"
      }
    }
  }
}