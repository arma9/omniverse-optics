{
  "OgnCamera": {
    "version": 1,
    "categories": "optics",
    "description": ["Optical camera node"],
    "language": "python",
    "inputs": {
      "sensor_size": {
        "type": "float",
        "description": "Sensor size of the camera"
      },
      "position": {
        "type": "float[3]",
        "description": "Position in world coordinates"
      }
    },
    "outputs": {
      "out": {
        "type": "token",
        "description": "Output token or data"
      }
    }
  }
}