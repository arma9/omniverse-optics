{
  "OgnLens": {
    "version": 1,
    "categories": "optics",
    "description": ["Optical lens node"],
    "language": "python",
    "inputs": {
      "focal_length": {
        "type": "float",
        "description": "Focal length of the lens (mm)"
      },
      "position": {
        "type": "float[3]",
        "description": "Position in world coordinates (x, y, z)"
      }
    },
    "outputs": {
      "out": {
        "type": "token",
        "description": "Output token or data"
      }
    }
  }
}
