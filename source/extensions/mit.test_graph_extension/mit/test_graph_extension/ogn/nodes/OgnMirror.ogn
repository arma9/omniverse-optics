{
  "OgnMirror": {
    "version": 1,
    "categories": "optics",
    "description": ["Optical mirror node"],
    "language": "python",
    "inputs": {
      "reflectivity": {
        "type": "float",
        "description": "Reflectivity of the mirror (0.0 to 1.0)"
      },
      "position": {
        "type": "float[3]",
        "description": "Position in world coordinates (x, y, z)"
      }
    },
    "outputs": {
      "out": {
        "type": "token",
        "description": "Reflected output beam"
      }
    }
  }
}
