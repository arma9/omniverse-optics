{
  "OgnBeamSplitter": {
    "version": 1,
    "categories": "optics",
    "description": ["Optical beam splitter node"],
    "language": "python",
    "inputs": {
      "split_ratio": {
        "type": "float",
        "description": "Split ratio (0.0 to 1.0, fraction of light to output 1)"
      },
      "position": {
        "type": "float[3]",
        "description": "Position in world coordinates (x, y, z)"
      }
    },
    "outputs": {
      "out1": {
        "type": "token",
        "description": "First output beam"
      },
      "out2": {
        "type": "token",
        "description": "Second output beam"
      }
    }
  }
}
